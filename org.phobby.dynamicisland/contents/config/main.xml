<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0 http://www.kde.org/standards/kcfg/1.0/kcfg.xsd">
  <kcfgfile name=""/>
  <group name="General">
    <!-- Appearance (Settings → Appearance; see Styles.qml) -->
    <!-- 0 = follow the system's colours, 1 = the custom style -->
    <entry name="appearanceMode" type="Int"><default>0</default></entry>
    <!-- Following the system: 0 = the colour scheme and its accent colour, 1 = the Plasma style (like the panel) -->
    <entry name="followSource" type="Int"><default>0</default></entry>
    <!-- JSON: the custom style; empty = Oxygen Metallic with the three earlier settings below -->
    <entry name="customStyle" type="String"><default></default></entry>
    <!-- JSON list of { name, style }: saved custom styles; and the name of the one in use -->
    <entry name="styleProfiles" type="String"><default>[]</default></entry>
    <entry name="activeProfile" type="String"><default></default></entry>
    <!-- Written by the settings page while it is open: what it is editing, shown at once (never kept) -->
    <entry name="previewActive" type="Bool"><default>false</default></entry>
    <entry name="previewMode" type="Int"><default>0</default></entry>
    <entry name="previewSource" type="Int"><default>0</default></entry>
    <entry name="previewStyle" type="String"><default></default></entry>
    <!-- Written by the widget: the applied colour scheme, "background,text,accent" (for the settings page) -->
    <entry name="systemScheme" type="String"><default></default></entry>
    <!-- Earlier appearance settings, only read to make the first custom style -->
    <entry name="surfaceOpacity" type="Int">
      <default>82</default>
      <min>30</min>
      <max>100</max>
    </entry>
    <entry name="blurEnabled" type="Bool">
      <default>true</default>
    </entry>
    <!-- (earlier) 0 = follow Plasma color scheme, 1 = always dark, 2 = always light -->
    <entry name="themeMode" type="Int">
      <default>1</default>
    </entry>
    <entry name="showClock" type="Bool">
      <default>true</default>
    </entry>
    <entry name="topMargin" type="Int">
      <default>6</default>
    </entry>
    <entry name="avoidPanels" type="Bool">
      <default>true</default>
    </entry>

    <!-- Behavior -->
    <entry name="showNotifications" type="Bool">
      <default>true</default>
    </entry>
    <entry name="notificationDuration" type="Int">
      <default>4000</default>
    </entry>
    <!-- Dot mode: a click shrinks the island to a small dot, a click on the dot brings the pill back -->
    <entry name="dotMode" type="Bool"><default>true</default></entry>
    <!-- whether it is a dot now (kept across restarts) -->
    <entry name="dotState" type="Bool"><default>false</default></entry>
    <!-- 0 = as it was left, 1 = always the pill, 2 = always the dot -->
    <entry name="dotStart" type="Int"><default>0</default></entry>
    <entry name="dotSize" type="Int"><default>15</default></entry>
    <entry name="dotHoverExpand" type="Bool"><default>false</default></entry>
    <!-- 0 = only the dot shows it, 1 = opens for it and returns to the dot, 2 = nothing -->
    <entry name="dotEvents" type="Int"><default>0</default></entry>
    <entry name="dotCriticalExpand" type="Bool"><default>true</default></entry>
    <entry name="hoverDelay" type="Int">
      <default>120</default>
    </entry>
    <entry name="collapseDelay" type="Int">
      <default>400</default>
    </entry>
    <entry name="preferredPlayer" type="String">
      <default>spotify</default>
    </entry>

    <!-- Activities -->
    <!-- Highest first. Categories: privacy, call, recording, event, timer, transfer, media -->
    <entry name="priorityOrder" type="String">
      <default>privacy,call,recording,event,timer,transfer,media</default>
    </entry>
    <entry name="splitIsland" type="Bool">
      <default>true</default>
    </entry>
    <entry name="keepMediaVisible" type="Bool">
      <default>true</default>
    </entry>
    <entry name="eventDuration" type="Int">
      <default>3000</default>
    </entry>

    <!-- System events -->
    <entry name="showPowerEvents" type="Bool"><default>true</default></entry>
    <entry name="lowBatteryThreshold" type="Int"><default>20</default></entry>
    <entry name="criticalBatteryThreshold" type="Int"><default>10</default></entry>
    <entry name="showBluetoothEvents" type="Bool"><default>true</default></entry>
    <entry name="deviceBatteryThreshold" type="Int"><default>15</default></entry>
    <entry name="showOsdEvents" type="Bool"><default>true</default></entry>
    <entry name="showKeyboardEvents" type="Bool"><default>true</default></entry>
    <entry name="showNetworkEvents" type="Bool"><default>true</default></entry>
    <entry name="showDndEvents" type="Bool"><default>true</default></entry>
    <entry name="showRecording" type="Bool"><default>true</default></entry>
    <entry name="showPrivacy" type="Bool"><default>true</default></entry>
    <entry name="showUnlock" type="Bool"><default>true</default></entry>
    <entry name="showJobs" type="Bool"><default>true</default></entry>
    <entry name="watchDownloads" type="Bool"><default>true</default></entry>
    <entry name="trackDownloads" type="Bool"><default>true</default></entry>
    <entry name="trackPackages" type="Bool"><default>true</default></entry>
    <entry name="trackGit" type="Bool"><default>true</default></entry>
    <entry name="trackTools" type="Bool"><default>true</default></entry>
    <entry name="trackBackground" type="Bool"><default>false</default></entry>
    <entry name="trackAnnounceEnd" type="Bool"><default>true</default></entry>
    <entry name="trackMinSeconds" type="Int"><default>1</default></entry>
    <entry name="trackMinKilobytes" type="Int"><default>1024</default></entry>
    <entry name="trackSettleSeconds" type="Int"><default>3</default></entry>
    <entry name="trackFolders" type="String"><default></default></entry>
    <entry name="trackCommandsAdded" type="String"><default></default></entry>
    <entry name="trackCommandsRemoved" type="String"><default></default></entry>
    <entry name="showKdeConnect" type="Bool"><default>true</default></entry>
    <entry name="showQuickSettings" type="Bool"><default>true</default></entry>
    <entry name="showUpdates" type="Bool"><default>true</default></entry>
    <!-- Written by the widget: the number of updates already announced -->
    <entry name="updatesAnnounced" type="Int"><default>0</default></entry>
    <entry name="showThermalWarning" type="Bool"><default>true</default></entry>
    <entry name="enableDbusApi" type="Bool"><default>true</default></entry>
    <entry name="cpuTempThreshold" type="Int"><default>90</default></entry>
    <entry name="gpuTempThreshold" type="Int"><default>85</default></entry>

    <!-- Time & productivity (end times are epoch ms strings so they survive restarts) -->
    <entry name="showTools" type="Bool"><default>true</default></entry>
    <entry name="timerEndsAt" type="String"><default>0</default></entry>
    <entry name="timerTotal" type="Int"><default>300</default></entry>
    <entry name="timerPausedRemaining" type="Int"><default>0</default></entry>
    <entry name="stopwatchStartedAt" type="String"><default>0</default></entry>
    <entry name="stopwatchElapsed" type="String"><default>0</default></entry>
    <entry name="stopwatchLaps" type="String"><default>[]</default></entry>
    <entry name="pomodoroPhase" type="String"><default></default></entry>
    <entry name="pomodoroEndsAt" type="String"><default>0</default></entry>
    <entry name="pomodoroRound" type="Int"><default>0</default></entry>
    <entry name="pomodoroWork" type="Int"><default>25</default></entry>
    <entry name="pomodoroShortBreak" type="Int"><default>5</default></entry>
    <entry name="pomodoroLongBreak" type="Int"><default>15</default></entry>
    <entry name="pomodoroRounds" type="Int"><default>4</default></entry>
    <!-- Written by the widget: JSON { days: { "YYYY-MM-DD": completed focus rounds }, total, best (longest streak) } -->
    <entry name="pomodoroStats" type="String"><default></default></entry>
    <entry name="alarmAt" type="String"><default>0</default></entry>
    <entry name="alarmTime" type="String"><default>07:00</default></entry>
    <entry name="alarmLabel" type="String"><default></default></entry>
    <entry name="timerSoundEnabled" type="Bool"><default>true</default></entry>
    <entry name="timerSound" type="String"><default>/usr/share/sounds/ocean/stereo/alarm-clock-elapsed.oga</default></entry>
    <entry name="showCalendar" type="Bool"><default>true</default></entry>
    <entry name="calendarLeadMinutes" type="Int"><default>15</default></entry>
    <entry name="calendarLingerMinutes" type="Int"><default>10</default></entry>
    <entry name="calendarShowAllDay" type="Bool"><default>true</default></entry>
    <entry name="calendarRefreshMinutes" type="Int"><default>5</default></entry>
    <!-- Play the timer/alarm sound (Tools tab) when an event starts -->
    <entry name="calendarSound" type="Bool"><default>true</default></entry>
    <!-- Written by the widget: JSON { "uid@start": end (ms) } of events dismissed from the island -->
    <entry name="calendarDismissed" type="String"><default>{}</default></entry>
    <!-- JSON list of { id, type, url, name, color, enabled }: iCalendar (.ics) links -->
    <entry name="calendarSources" type="String"><default>[]</default></entry>
    <!-- Written by the widget: JSON { source id: { t: ms, error } } (shown in the settings) -->
    <entry name="calendarStatus" type="String"><default>{}</default></entry>
    <!-- Account for adding events (CalDAV): JSON { server, user, calendars: [{ url, name, color }], defaultUrl }.
         The password is kept in KWallet, never here. -->
    <entry name="calendarAccount" type="String"><default>{}</default></entry>
    <!-- Google account (OAuth): the desktop client registered in Google Cloud, and
         JSON { user, calendars: [{ id, name, color, writable }] }. The refresh token is kept in KWallet. -->
    <entry name="googleClientId" type="String"><default></default></entry>
    <entry name="googleClientSecret" type="String"><default></default></entry>
    <entry name="googleAccount" type="String"><default>{}</default></entry>
    <!-- Notes: JSON list of { id, type (joplin|simplenote|memos), name, server, user }.
         Tokens are kept in KWallet, never here. -->
    <entry name="showNotes" type="Bool"><default>true</default></entry>
    <entry name="showClipboard" type="Bool"><default>true</default></entry>
    <!-- Weather: the page; its place, chosen on the page by name: JSON { name, admin, country,
         latitude, longitude } ("" = none yet, the page starts empty); the units (0 = °C, km/h, mm;
         1 = °F, mph, in); the alert for rain, snow and storms, and (written by the widget) what
         was already announced -->
    <entry name="showWeather" type="Bool"><default>true</default></entry>
    <entry name="weatherLocation" type="String"><default></default></entry>
    <entry name="weatherUnits" type="Int"><default>0</default></entry>
    <!-- Earlier (the place of Plasma's weather engine and its name): the name only starts the first search -->
    <entry name="weatherPlace" type="String"><default></default></entry>
    <entry name="weatherPlaceName" type="String"><default></default></entry>
    <entry name="showWeatherAlerts" type="Bool"><default>true</default></entry>
    <entry name="weatherAnnounced" type="String"><default></default></entry>
    <!-- Apps: the page and its shortcuts, JSON list of { id (menu id of the .desktop file), name, icon, label } -->
    <entry name="showApps" type="Bool"><default>true</default></entry>
    <entry name="appShortcuts" type="String"><default>[]</default></entry>
    <!-- Habits: the page, the evening review ("HH:MM") and its reminder on the island, the colours of the
         calendar (0 = GitHub's greens, 1 = the system's accent colour) and, written by the widget, the record
         itself: JSON { habits, days: { "YYYY-MM-DD": { r, on, off, x } }, plan, runs, … }, see Habits.js -->
    <entry name="showHabits" type="Bool"><default>true</default></entry>
    <entry name="habitsReviewTime" type="String"><default>21:30</default></entry>
    <entry name="habitsReminder" type="Bool"><default>true</default></entry>
    <entry name="habitsColorSource" type="Int"><default>0</default></entry>
    <entry name="habitsData" type="String"><default></default></entry>
    <entry name="notesSources" type="String"><default>[]</default></entry>
    <entry name="notesDefault" type="String"><default></default></entry>
    <entry name="notesRefreshMinutes" type="Int"><default>2</default></entry>
    <!-- Carry on where one left off: on/off, and (written by the widget) the note last open in the
         editor: JSON { source, id, editing }. Never a note's text, never a password -->
    <entry name="notesResume" type="Bool"><default>true</default></entry>
    <entry name="notesLastOpen" type="String"><default></default></entry>

    <!-- Suggestions: on/off; the least pause between two of them (minutes); written by the widget:
         the rules this system can make (for the settings page) and, only when the native module
         is missing, what was learned (it is a file otherwise; see SuggestionStore.qml) -->
    <entry name="suggestionsEnabled" type="Bool"><default>true</default></entry>
    <entry name="suggestionGapMinutes" type="Int">
      <default>5</default>
      <min>1</min>
      <max>240</max>
    </entry>
    <!-- "quiet", "balanced", "active"; the three numbers: 0 = what the level says -->
    <entry name="suggestionLevel" type="String"><default>balanced</default></entry>
    <entry name="suggestionDailyCards" type="Int"><default>0</default></entry>
    <entry name="suggestionCooldownMinutes" type="Int"><default>0</default></entry>
    <entry name="suggestionHalfLifeDays" type="Int"><default>0</default></entry>
    <entry name="suggestionsAvailable" type="String"><default></default></entry>
    <entry name="suggestionsData" type="String"><default></default></entry>

    <!-- AI: quick questions to Claude Code on this computer, a local model server or a service with a key.
         The page is off until the user switches it on (Settings → Layout or AI). The sources: JSON list of { id, kind, server, model } (kinds: ui/ai/AiCatalog.qml). Keys are
         kept in KWallet, never here. The longest answer (tokens) and question (characters); whether the
         chat is also kept in a file; and, written by the widget, the sources whose notice was accepted -->
    <entry name="showAi" type="Bool"><default>false</default></entry>
    <entry name="aiSources" type="String"><default>[]</default></entry>
    <entry name="aiDefault" type="String"><default></default></entry>
    <entry name="aiMaxTokens" type="Int">
      <default>2048</default>
      <min>128</min>
      <max>8192</max>
    </entry>
    <entry name="aiMaxChars" type="Int">
      <default>4000</default>
      <min>200</min>
      <max>20000</max>
    </entry>
    <entry name="aiKeepHistory" type="Bool"><default>false</default></entry>
    <!-- "Answer ready" on the small island when an answer arrived while its page was not on screen -->
    <entry name="aiNotify" type="Bool"><default>true</default></entry>
    <entry name="aiAcknowledged" type="String"><default>[]</default></entry>

    <!-- Cloud: the user's rclone remotes as folders of names, with sync state where a client on this
         computer says it. Off until switched on. The remotes not shown and the names given to them
         (JSON), the storage thresholds (percent), alerts and their pause (hours), the question before
         an upload, up to which size a file is fetched when the pointer rests on it and how large the
         cache may get (MB), the indicator on the small island; written by the widget: when each
         alert was last said, and where the last upload went. Never a token or a password -->
    <entry name="showCloud" type="Bool"><default>false</default></entry>
    <entry name="cloudIndicator" type="Bool"><default>true</default></entry>
    <entry name="cloudHidden" type="String"><default>[]</default></entry>
    <entry name="cloudAliases" type="String"><default>{}</default></entry>
    <entry name="cloudWarnPercent" type="Int"><default>90</default><min>50</min><max>100</max></entry>
    <entry name="cloudCriticalPercent" type="Int"><default>98</default><min>50</min><max>100</max></entry>
    <entry name="cloudAlerts" type="Bool"><default>true</default></entry>
    <entry name="cloudAlertPauseHours" type="Int"><default>6</default><min>1</min><max>168</max></entry>
    <entry name="cloudConfirmUpload" type="Bool"><default>true</default></entry>
    <entry name="cloudAutoFetchMB" type="Int"><default>25</default><min>0</min><max>1000</max></entry>
    <entry name="cloudCacheMB" type="Int"><default>500</default><min>50</min><max>20000</max></entry>
    <entry name="cloudAlerted" type="String"><default>{}</default></entry>
    <entry name="cloudLastTarget" type="String"><default></default></entry>

    <!-- Not in the settings window: draws the outline of where the island takes the pointer (also with
         the environment variable DYNAMICISLAND_DEBUG_REGION) -->
    <entry name="debugInputRegion" type="Bool"><default>false</default></entry>

    <!-- Modules -->
    <entry name="showMediaModule" type="Bool">
      <default>true</default>
    </entry>
    <!-- 0 = fixed (5 cards, 3+2), 1 = dynamic (active metrics grow) -->
    <entry name="systemView" type="Int">
      <default>1</default>
    </entry>
    <entry name="showSystemModule" type="Bool">
      <default>true</default>
    </entry>
    <entry name="showVolumeModule" type="Bool">
      <default>true</default>
    </entry>
    <entry name="showNotificationModule" type="Bool">
      <default>true</default>
    </entry>
    <!-- Order of the expanded pages (Settings → Layout), comma-separated keys; see PageCatalog.qml -->
    <entry name="pageOrder" type="String">
      <default>activities,media,control,weather,notifications,quicksettings,apps,tools,habits,calendar,notes,ai,cloud,clipboard</default>
    </entry>
    <!-- Ambient glow: the island's edge in the colour of the album cover, following the music (Media page) -->
    <entry name="ambientGlow" type="Bool"><default>false</default></entry>
    <!-- Buttons of the Controls page, in order, at most 6 (Settings → Controls); see ControlCatalog.qml -->
    <entry name="controlTiles" type="String">
      <default>dnd,nightlight,power,bluetooth,wifi,updates</default>
    </entry>
    <!-- Colour schemes the "Dark mode" button switches between (remembered when it switches away) -->
    <entry name="darkColorScheme" type="String"><default></default></entry>
    <entry name="lightColorScheme" type="String"><default></default></entry>
    <!-- Language of the widget: auto (the system's), tr or en; see Lang.qml -->
    <entry name="language" type="String">
      <default>auto</default>
    </entry>
  </group>
</kcfg>

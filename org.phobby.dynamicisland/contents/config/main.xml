<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0 http://www.kde.org/standards/kcfg/1.0/kcfg.xsd">
  <kcfgfile name=""/>
  <group name="General">
    <!-- Appearance -->
    <entry name="surfaceOpacity" type="Int">
      <default>82</default>
      <min>30</min>
      <max>100</max>
    </entry>
    <entry name="blurEnabled" type="Bool">
      <default>true</default>
    </entry>
    <!-- 0 = follow Plasma color scheme, 1 = always dark, 2 = always light -->
    <entry name="themeMode" type="Int">
      <default>1</default>
    </entry>
    <entry name="showClock" type="Bool">
      <default>true</default>
    </entry>
    <entry name="topMargin" type="Int">
      <default>6</default>
    </entry>
    <entry name="avoidPanels" type="Bool">
      <default>true</default>
    </entry>

    <!-- Behavior -->
    <entry name="showNotifications" type="Bool">
      <default>true</default>
    </entry>
    <entry name="notificationDuration" type="Int">
      <default>4000</default>
    </entry>
    <entry name="hoverDelay" type="Int">
      <default>120</default>
    </entry>
    <entry name="collapseDelay" type="Int">
      <default>400</default>
    </entry>
    <entry name="preferredPlayer" type="String">
      <default>spotify</default>
    </entry>

    <!-- Activities -->
    <!-- Highest first. Categories: privacy, call, recording, event, timer, transfer, media -->
    <entry name="priorityOrder" type="String">
      <default>privacy,call,recording,event,timer,transfer,media</default>
    </entry>
    <entry name="splitIsland" type="Bool">
      <default>true</default>
    </entry>
    <entry name="keepMediaVisible" type="Bool">
      <default>true</default>
    </entry>
    <entry name="eventDuration" type="Int">
      <default>3000</default>
    </entry>

    <!-- System events -->
    <entry name="showPowerEvents" type="Bool"><default>true</default></entry>
    <entry name="lowBatteryThreshold" type="Int"><default>20</default></entry>
    <entry name="criticalBatteryThreshold" type="Int"><default>10</default></entry>
    <entry name="showBluetoothEvents" type="Bool"><default>true</default></entry>
    <entry name="deviceBatteryThreshold" type="Int"><default>15</default></entry>
    <entry name="showOsdEvents" type="Bool"><default>true</default></entry>
    <entry name="showKeyboardEvents" type="Bool"><default>true</default></entry>
    <entry name="showNetworkEvents" type="Bool"><default>true</default></entry>
    <entry name="showDndEvents" type="Bool"><default>true</default></entry>
    <entry name="showDevicesModule" type="Bool"><default>true</default></entry>
    <entry name="showRecording" type="Bool"><default>true</default></entry>
    <entry name="showPrivacy" type="Bool"><default>true</default></entry>
    <entry name="showUnlock" type="Bool"><default>true</default></entry>
    <entry name="showJobs" type="Bool"><default>true</default></entry>
    <entry name="watchDownloads" type="Bool"><default>true</default></entry>
    <entry name="showKdeConnect" type="Bool"><default>true</default></entry>
    <entry name="showQuickSettings" type="Bool"><default>true</default></entry>
    <entry name="showUpdates" type="Bool"><default>true</default></entry>
    <!-- Written by the widget: the number of updates already announced -->
    <entry name="updatesAnnounced" type="Int"><default>0</default></entry>
    <entry name="showThermalWarning" type="Bool"><default>true</default></entry>
    <entry name="enableDbusApi" type="Bool"><default>true</default></entry>
    <entry name="cpuTempThreshold" type="Int"><default>90</default></entry>
    <entry name="gpuTempThreshold" type="Int"><default>85</default></entry>

    <!-- Time & productivity (end times are epoch ms strings so they survive restarts) -->
    <entry name="showTools" type="Bool"><default>true</default></entry>
    <entry name="timerEndsAt" type="String"><default>0</default></entry>
    <entry name="timerTotal" type="Int"><default>300</default></entry>
    <entry name="timerPausedRemaining" type="Int"><default>0</default></entry>
    <entry name="stopwatchStartedAt" type="String"><default>0</default></entry>
    <entry name="stopwatchElapsed" type="String"><default>0</default></entry>
    <entry name="stopwatchLaps" type="String"><default>[]</default></entry>
    <entry name="pomodoroPhase" type="String"><default></default></entry>
    <entry name="pomodoroEndsAt" type="String"><default>0</default></entry>
    <entry name="pomodoroRound" type="Int"><default>0</default></entry>
    <entry name="pomodoroWork" type="Int"><default>25</default></entry>
    <entry name="pomodoroShortBreak" type="Int"><default>5</default></entry>
    <entry name="pomodoroLongBreak" type="Int"><default>15</default></entry>
    <entry name="pomodoroRounds" type="Int"><default>4</default></entry>
    <entry name="alarmAt" type="String"><default>0</default></entry>
    <entry name="alarmTime" type="String"><default>07:00</default></entry>
    <entry name="alarmLabel" type="String"><default></default></entry>
    <entry name="timerSoundEnabled" type="Bool"><default>true</default></entry>
    <entry name="timerSound" type="String"><default>/usr/share/sounds/ocean/stereo/alarm-clock-elapsed.oga</default></entry>
    <entry name="showCalendar" type="Bool"><default>true</default></entry>
    <entry name="calendarLeadMinutes" type="Int"><default>15</default></entry>
    <entry name="calendarLingerMinutes" type="Int"><default>10</default></entry>
    <entry name="calendarShowAllDay" type="Bool"><default>true</default></entry>
    <entry name="calendarRefreshMinutes" type="Int"><default>5</default></entry>
    <!-- Play the timer/alarm sound (Tools tab) when an event starts -->
    <entry name="calendarSound" type="Bool"><default>true</default></entry>
    <!-- Written by the widget: JSON { "uid@start": end (ms) } of events dismissed from the island -->
    <entry name="calendarDismissed" type="String"><default>{}</default></entry>
    <!-- JSON list of { id, type, url, name, color, enabled }: iCalendar (.ics) links -->
    <entry name="calendarSources" type="String"><default>[]</default></entry>
    <!-- Written by the widget: JSON { source id: { t: ms, error } } (shown in the settings) -->
    <entry name="calendarStatus" type="String"><default>{}</default></entry>
    <!-- Account for adding events (CalDAV): JSON { server, user, calendars: [{ url, name, color }], defaultUrl }.
         The password is kept in KWallet, never here. -->
    <entry name="calendarAccount" type="String"><default>{}</default></entry>
    <!-- Google account (OAuth): the desktop client registered in Google Cloud, and
         JSON { user, calendars: [{ id, name, color, writable }] }. The refresh token is kept in KWallet. -->
    <entry name="googleClientId" type="String"><default></default></entry>
    <entry name="googleClientSecret" type="String"><default></default></entry>
    <entry name="googleAccount" type="String"><default>{}</default></entry>
    <!-- Notes: JSON list of { id, type (joplin|simplenote|memos), name, server, user }.
         Tokens are kept in KWallet, never here. -->
    <entry name="showNotes" type="Bool"><default>true</default></entry>
    <entry name="showClipboard" type="Bool"><default>true</default></entry>
    <entry name="notesSources" type="String"><default>[]</default></entry>
    <entry name="notesDefault" type="String"><default></default></entry>
    <entry name="notesRefreshMinutes" type="Int"><default>2</default></entry>

    <!-- Modules -->
    <entry name="showMediaModule" type="Bool">
      <default>true</default>
    </entry>
    <!-- 0 = fixed (5 cards, 3+2), 1 = dynamic (active metrics grow) -->
    <entry name="systemView" type="Int">
      <default>1</default>
    </entry>
    <entry name="showSystemModule" type="Bool">
      <default>true</default>
    </entry>
    <entry name="showVolumeModule" type="Bool">
      <default>true</default>
    </entry>
    <entry name="showNotificationModule" type="Bool">
      <default>true</default>
    </entry>
    <!-- Order of the expanded pages (Settings → Layout), comma-separated keys; see PageCatalog.qml -->
    <entry name="pageOrder" type="String">
      <default>activities,media,control,notifications,quicksettings,tools,calendar,notes,clipboard,devices</default>
    </entry>
    <!-- Buttons of the Controls page, in order, at most 6 (Settings → Controls); see ControlCatalog.qml -->
    <entry name="controlTiles" type="String">
      <default>dnd,nightlight,power,bluetooth,wifi,updates</default>
    </entry>
    <!-- Colour schemes the "Dark mode" button switches between (remembered when it switches away) -->
    <entry name="darkColorScheme" type="String"><default></default></entry>
    <entry name="lightColorScheme" type="String"><default></default></entry>
    <!-- Language of the widget: auto (the system's), tr or en; see Lang.qml -->
    <entry name="language" type="String">
      <default>auto</default>
    </entry>
  </group>
</kcfg>

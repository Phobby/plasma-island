#!/bin/sh
# A stand-in for the `claude` command, for tests/tst_ai_cli.qml: it prints what
# `claude -p --output-format stream-json` prints, without asking anybody.
# What it was started with is written to tests/.run/fake-claude/ (args, one
# per line; cwd; stdin), so a test can see where the question went and where
# it did not. The scene is chosen with --model:
#
#   (none)      an answer in two pieces            whole       no pieces, only the finished message
#   tools-on    it starts with tools               mcp-on      it starts with an MCP server
#   elsewhere   it starts in another folder        noinit      it never says what it runs with
#   reaches     the model reaches for a tool (and, left alone, would make a file)
#   signedout   "Not logged in"                    limit       the usage limit
#   nomodel     the model is not known             oldcli      it does not know an option
#   slow        a piece every 0.2 s for 10 s       silent      starts, then nothing
here="$(cd "$(dirname "$0")" && pwd)"
box="$here/.run/fake-claude"
mkdir -p "$box"

case "$1" in
    --version) echo "9.9.9 (Claude Code)"; exit 0 ;;
    --help)
        cat <<'EOF'
Usage: claude [options] [command] [prompt]

Options:
  --mcp-config <configs...>             Load MCP servers from JSON files or
                                        strings (space-separated)
  --model <model>                       Model for the current session. Provide
                                        an alias for the latest model (e.g.
                                        'fable', 'opus', or 'sonnet') or a
                                        model's full name.
  -n, --name <name>                     Set a display name for this session
EOF
        exit 0 ;;
    auth)
        pwd > "$box/auth-cwd"
        if [ -e "$box/signed-out" ]; then echo '{"loggedIn": false}'; exit 1; fi
        echo '{"loggedIn": true, "email": "someone@example.org"}'; exit 0 ;;
esac

: > "$box/args"
scene=""
previous=""
for arg in "$@"; do
    printf '%s\n' "$arg" >> "$box/args"
    [ "$previous" = "--model" ] && scene="$arg"
    previous="$arg"
done
pwd > "$box/cwd"
cat > "$box/stdin"

init() {    # tools, servers, cwd
    printf '{"type":"system","subtype":"init","cwd":"%s","tools":%s,"mcp_servers":%s,"model":"fake","permissionMode":"dontAsk"}\n' "$3" "$1" "$2"
    printf '{"type":"system","subtype":"status","status":"requesting"}\n'
}
piece() { printf '{"type":"stream_event","event":{"type":"content_block_delta","index":0,"delta":{"type":"text_delta","text":"%s"}}}\n' "$1"; }
whole() { printf '{"type":"assistant","message":{"role":"assistant","content":[{"type":"thinking","thinking":""},{"type":"text","text":"%s"}]}}\n' "$1"; }
result() {  # is_error, text, api status, subtype
    printf '{"type":"result","subtype":"%s","is_error":%s,"api_error_status":%s,"result":"%s","num_turns":1,"permission_denials":[]}\n' "${4:-success}" "$1" "${3:-null}" "$2"
}

case "$scene" in
    tools-on)  init '["Bash","Read"]' '[]' "$PWD"; piece "leaked"; whole "leaked"; result false "leaked" ;;
    mcp-on)    init '[]' '[{"name":"notes","status":"connected"}]' "$PWD"; piece "leaked"; result false "leaked" ;;
    elsewhere) init '[]' '[]' "/home/someone/project"; piece "leaked"; result false "leaked" ;;
    noinit)    piece "leaked"; whole "leaked"; result false "leaked" ;;
    whole)     init '[]' '[]' "$PWD"; whole "All at once."; result false "All at once." ;;
    reaches)
        init '[]' '[]' "$PWD"
        piece "Let me look. "
        printf '{"type":"stream_event","event":{"type":"content_block_start","index":1,"content_block":{"type":"tool_use","id":"toolu_1","name":"Bash","input":{}}}}\n'
        sleep 3
        echo made > "$PWD/made-by-a-tool"
        result false "done" ;;
    signedout) init '[]' '[]' "$PWD"; result true "Not logged in · Please run /login"; exit 1 ;;
    limit)
        init '[]' '[]' "$PWD"
        printf '{"type":"rate_limit_event","rate_limit_info":{"status":"rejected","rateLimitType":"five_hour"}}\n'
        result true "You have hit your limit"; exit 1 ;;
    nomodel)   init '[]' '[]' "$PWD"; result true "There is an issue with the selected model (nomodel)." 404; exit 1 ;;
    oldcli)    echo "error: unknown option '--safe-mode'" >&2; exit 1 ;;
    slow)
        init '[]' '[]' "$PWD"
        i=0
        while [ $i -lt 50 ]; do piece "word "; sleep 0.2; i=$((i + 1)); done
        result false "" ;;
    silent)    init '[]' '[]' "$PWD"; sleep 60 ;;
    *)
        init '[]' '[]' "$PWD"
        printf '{"type":"stream_event","event":{"type":"content_block_start","index":0,"content_block":{"type":"text","text":""}}}\n'
        piece "2+2 "
        sleep 0.2
        piece "is 4."
        whole "2+2 is 4."
        printf '{"type":"rate_limit_event","rate_limit_info":{"status":"allowed_warning"}}\n'
        result false "2+2 is 4." ;;
esac
exit 0

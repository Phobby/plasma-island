#!/usr/bin/env python3
# eipointer — a pointer for tools/nested-session's headless KWin: moves, glides, presses and
# releases the left button through KWin's emulated input (libei), so that hovering, clicking and
# dragging a window by its title can be played there without a mouse. It asks the session's own
# KWin for an input device over D-Bus (org.kde.KWin /org/kde/KWin/EIS/RemoteDesktop); the real
# pointer of your own session is never touched.
#
#   tools/nested-session run python3 tools/eipointer STEP…
#     move X Y          the pointer to X, Y (logical pixels of the session's screen)
#     glide X Y MS      there in a straight line, in MS milliseconds (one step every 10 ms)
#     down | up         the left button
#     push DX DY N      N relative moves of DX, DY (against an edge: what reveals a panel that hides)
#     sleep MS
#
# One connection per run: each run is a device of its own, and a new device's first events can be
# lost, so a run starts with a short wait after the device is there.
import ctypes, os, select, sys, time
import dbus

ei = ctypes.CDLL("libei.so.1")
P = ctypes.c_void_p
for name, res, args in [
        ("ei_new_sender", P, [P]), ("ei_configure_name", None, [P, ctypes.c_char_p]),
        ("ei_setup_backend_fd", ctypes.c_int, [P, ctypes.c_int]), ("ei_get_fd", ctypes.c_int, [P]),
        ("ei_dispatch", None, [P]), ("ei_get_event", P, [P]), ("ei_event_get_type", ctypes.c_int, [P]),
        ("ei_event_get_seat", P, [P]), ("ei_event_get_device", P, [P]), ("ei_event_unref", P, [P]),
        ("ei_device_ref", P, [P]), ("ei_device_start_emulating", None, [P, ctypes.c_uint32]),
        ("ei_device_stop_emulating", None, [P]),
        ("ei_device_pointer_motion_absolute", None, [P, ctypes.c_double, ctypes.c_double]),
        ("ei_device_pointer_motion", None, [P, ctypes.c_double, ctypes.c_double]),
        ("ei_device_button_button", None, [P, ctypes.c_uint32, ctypes.c_bool]),
        ("ei_device_frame", None, [P, ctypes.c_uint64]), ("ei_now", ctypes.c_uint64, [P]),
        ("ei_device_has_capability", ctypes.c_bool, [P, ctypes.c_int])]:
    f = getattr(ei, name); f.restype = res; f.argtypes = args
# (variadic: the capabilities, ended by a null)
ei.ei_seat_bind_capabilities.restype = None

CONNECT, SEAT_ADDED, DEVICE_ADDED, DEVICE_RESUMED = 1, 3, 5, 8
CAP_POINTER, CAP_POINTER_ABSOLUTE, CAP_BUTTON = 1 << 0, 1 << 1, 1 << 5
BTN_LEFT = 0x110

bus = dbus.SessionBus()
remote = bus.get_object("org.kde.KWin", "/org/kde/KWin/EIS/RemoteDesktop")
fd, _cookie = remote.connectToEIS(dbus.Int32(63), dbus_interface="org.kde.KWin.EIS.RemoteDesktop")
ctx = ei.ei_new_sender(None)
ei.ei_configure_name(ctx, b"island-eipointer")
if ei.ei_setup_backend_fd(ctx, os.dup(fd.take())) != 0:
    sys.exit("eipointer: libei could not use KWin's connection")

device = None
relative = None
devices = []
def pump(timeout):
    global device, relative
    r, _, _ = select.select([ei.ei_get_fd(ctx)], [], [], timeout)
    ei.ei_dispatch(ctx)
    while True:
        e = ei.ei_get_event(ctx)
        if not e: break
        kind = ei.ei_event_get_type(e)
        if kind == SEAT_ADDED:
            ei.ei_seat_bind_capabilities(P(ei.ei_event_get_seat(e)), ctypes.c_int(1), ctypes.c_int(2), ctypes.c_int(4),
                                         ctypes.c_int(8), ctypes.c_int(16), ctypes.c_int(32), P(None))
        elif kind == DEVICE_ADDED:
            d = ei.ei_event_get_device(e)
            if ei.ei_device_has_capability(d, CAP_POINTER_ABSOLUTE) and device is None:
                device = ei.ei_device_ref(d); devices.append(device)
            elif ei.ei_device_has_capability(d, CAP_POINTER) and relative is None:
                relative = ei.ei_device_ref(d); devices.append(relative)
        elif kind == DEVICE_RESUMED:
            d = ei.ei_event_get_device(e)
            for k in devices:
                if k == d: ei.ei_device_start_emulating(k, 1)
        ei.ei_event_unref(e)

deadline = time.time() + 5
while device is None and time.time() < deadline:
    pump(0.1)
if device is None:
    sys.exit("eipointer: KWin gave no pointer device")
for _ in range(20): pump(0.01)

def frame():
    ei.ei_device_frame(device, ei.ei_now(ctx))
    pump(0)
where = [0.0, 0.0]
def move(x, y):
    where[:] = [x, y]
    ei.ei_device_pointer_motion_absolute(device, x, y); frame()

steps = sys.argv[1:]
i = 0
while i < len(steps):
    s = steps[i]
    if s == "move": move(float(steps[i + 1]), float(steps[i + 2])); i += 3
    elif s == "glide":
        x0, y0 = where; x1, y1, ms = float(steps[i + 1]), float(steps[i + 2]), float(steps[i + 3])
        n = max(1, int(ms / 10))
        for k in range(1, n + 1):
            move(x0 + (x1 - x0) * k / n, y0 + (y1 - y0) * k / n); time.sleep(0.01)
        i += 4
    elif s == "push":
        dx, dy, n = float(steps[i + 1]), float(steps[i + 2]), int(steps[i + 3])
        if relative is None: sys.exit("eipointer: KWin gave no relative pointer")
        for _ in range(n):
            ei.ei_device_pointer_motion(relative, dx, dy); ei.ei_device_frame(relative, ei.ei_now(ctx)); pump(0); time.sleep(0.01)
        i += 4
    elif s in ("down", "up"):
        ei.ei_device_button_button(device, BTN_LEFT, s == "down"); frame(); i += 1
    elif s == "sleep": time.sleep(float(steps[i + 1]) / 1000); pump(0); i += 2
    else: sys.exit("eipointer: unknown step " + s)
for _ in range(10): pump(0.01)
for k in devices: ei.ei_device_stop_emulating(k)
pump(0.05)

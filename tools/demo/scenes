#!/usr/bin/env python3
# scenes — the clips of the README, each one a short scripted scene in tools/nested-session.
#
#   tools/demo/scenes --list
#   tools/demo/scenes [--out docs/media] NAME…      record these
#   tools/demo/scenes [--out docs/media] --headless every scene that needs no pointer
#   tools/demo/scenes --prepare                     only set the session up (data, server, player, a fresh island)
#
# A scene sets the island up with made-up data (tools/demo/make-data, a local
# server, the demo player), then records itself with tools/demo/record while
# it plays: notifications sent over D-Bus, an activity pushed, the player told
# to go on, a setting changed. The session is started if it is not running
# (headless, with its silent PipeWire).
#
# Scenes marked "pointer" open the island, click and type: they need a windowed
# session and tools/demo/pointer, which moves your real pointer. They are not
# in this file yet; docs/media/STORYBOARDS.md says how each is shot.
#
# Everything shown is invented (names, messages, events, files); the weather
# is a real forecast for a large city, not for where anyone lives. A screen
# recording is a stand-in: a video stream of a black picture inside the
# session, which a made-up "Recorder" reads (the island sees it as any
# screen recording); an incoming call is the signal KDE Connect sends,
# sent in the session with a made-up caller.
#
# The desktop is Breeze Dark with a top panel, as the notch is meant to sit
# over one; the clips are cut to the top middle of the screen.
import argparse, json, os, shlex, subprocess, sys, time
from pathlib import Path

HERE = Path(__file__).resolve().parent
REPO = HERE.parent.parent
SESSION = str(REPO / "tools" / "nested-session")
PORT = 8377
# the top middle of a 1920x1080 screen: the notch with room for the cat, a notification and the glow
NOTCH = "560,0,800,110"

def root():
    return Path(os.environ.get("ISLAND_SESSION_DIR") or Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "dynamicisland-session")

def session(*args, capture=False, check=False):
    r = subprocess.run([SESSION, *args], stdout=subprocess.PIPE if capture else subprocess.DEVNULL, stderr=subprocess.DEVNULL, text=True)
    if check and r.returncode != 0: sys.exit(f"tools/nested-session {' '.join(args[:2])} failed")
    return (r.stdout or "").strip()

def inside(*command):
    """Run a command in the session (when this script itself runs there, directly)."""
    if "ISLAND_SESSION" in os.environ: return subprocess.run(list(command), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return subprocess.run([SESSION, "run", *command], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

# ---- what a scene can do ------------------------------------------------------
def wait(seconds): time.sleep(seconds)
def notify(app, title, body, icon="dialog-information", ms=3500):
    inside("gdbus", "call", "--session", "--dest", "org.freedesktop.Notifications", "--object-path", "/org/freedesktop/Notifications",
           "--method", "org.freedesktop.Notifications.Notify", app, "0", icon, title, body, "[]", "{}", str(ms))
def player(method):
    inside("gdbus", "call", "--session", "--dest", "org.mpris.MediaPlayer2.islanddemo", "--object-path", "/org/mpris/MediaPlayer2",
           "--method", f"org.mpris.MediaPlayer2.Player.{method}")
def push(*args):
    inside(str(root() / "home" / ".local" / "bin" / "island-push"), *args)
def setting(*pairs):
    session("set", *pairs)
def theme(name):
    return json.dumps(json.loads((REPO / "catalog" / "themes" / f"{name}.islandtheme.json").read_text())["style"])
def start_player(paused=False):
    stop("tools/demo/player", "pw-play")
    session("spawn", "player", str(HERE / "player"), str(root() / "media"), *(["--paused"] if paused else []))
def stop(*names):
    # (the whole command line from /proc: `ps` cuts it, and a long checkout path hides the name)
    for line in session("ps", capture=True).splitlines():
        pid = line.split()[0]
        try: command = Path(f"/proc/{pid}/cmdline").read_bytes().replace(b"\0", b" ").decode(errors="replace")
        except OSError: continue
        if any(n in command for n in names): subprocess.run(["kill", pid], stderr=subprocess.DEVNULL)
def top_panel():
    """A top panel as a desktop has one: the launcher on the left, the clock on the right, nothing in the middle."""
    inside("qdbus6", "org.kde.plasmashell", "/PlasmaShell", "org.kde.PlasmaShell.evaluateScript",
           "var p = new Panel('org.kde.panel'); p.location = 'top'; p.height = 32; p.floating = false;"
           " p.addWidget('org.kde.plasma.kickoff'); p.addWidget('org.kde.plasma.panelspacer'); p.addWidget('org.kde.plasma.digitalclock');")
def fresh(**settings):
    """A new island with default settings, then these; the shell started with them in place, a top panel added."""
    session("shell", "--no-island")
    # (what an island keeps beside Plasma's settings would come back into the new one: the copy of its
    # settings, and what the suggestions learned, which keeps a suggestion from asking twice)
    for kept in ("settings.json", "suggestions.json"):
        (root() / "home" / ".local" / "share" / "dynamicisland" / kept).unlink(missing_ok=True)
    session("shell")
    pairs = []
    for key, value in settings.items(): pairs += [key, value]
    if pairs:
        session("set", *pairs); session("shell")
    top_panel()
    time.sleep(5)
def call(event, number="+1 555 0100", name="Robin Example"):
    inside("gdbus", "emit", "--session", "--object-path", "/modules/kdeconnect/devices/demo/telephony",
           "--signal", "org.kde.kdeconnect.device.telephony.callReceived", event, number, name)
def screen_stream():
    """The stand-in for a screen recording: a source of black pictures and a reader, not joined yet."""
    stop("gst-launch")
    session("spawn", "screen", "gst-launch-1.0", "-q", "videotestsrc", "is-live=true", "pattern=black", "!",
            "video/x-raw,width=320,height=180,framerate=10/1", "!", "pipewiresink", "mode=provide",
            "stream-properties=props,node.name=demo-screen,media.class=Video/Source")
    session("spawn", "recorder", "gst-launch-1.0", "-q", "pipewiresrc", "autoconnect=false",
            "stream-properties=props,application.name=Recorder,node.name=demo-recorder", "!", "fakesink")
    time.sleep(3)
def recording(on):
    inside("pw-link", *(["-d"] if not on else []), "demo-screen:capture_1", "demo-recorder:input_1")

def prepare():
    if not session("pid", "kwin_wayland", capture=True):
        session("start", "--audio", check=True)
        inside("plasma-apply-colorscheme", "BreezeDark"); inside("plasma-apply-desktoptheme", "breeze-dark")
    session("install", check=True)
    data = root() / "demo"
    if not (root() / "media" / "tracks.tsv").exists():
        subprocess.run([str(HERE / "make-media"), str(root() / "media")], check=True, stdout=subprocess.DEVNULL)
    subprocess.run([str(HERE / "make-data"), str(data), "--port", str(PORT)], check=True, stdout=subprocess.DEVNULL)
    stop("tools/demo/serve")
    session("spawn", "serve", str(HERE / "serve"), str(data), "--port", str(PORT), "--rate", "24")
    return data

# ---- the scenes ---------------------------------------------------------------
# name → (what the clip shows, crop, set-up, play). `play` runs while the clip is recorded.
def setup_plain(): fresh(catSleepSeconds="600"); stop("tools/demo/player", "pw-play")
def play_states():
    wait(1.5)
    notify("Messages", "Morgan Example", "Are we still on for the lake on Saturday?", "mail-unread")
    wait(4.0)
    push("--id", "build", "--title", "Build", "--subtitle", "compiling", "--icon", "run-build", "--progress", "20")
    for p in (45, 70, 90):
        wait(0.9); push("--id", "build", "--progress", str(p), "--subtitle", "linking" if p > 60 else "compiling")
    wait(0.9); push("--id", "build", "--done", "--status", "success")
    wait(2.0)

def setup_notifications(): fresh(catEnabled="false"); stop("tools/demo/player", "pw-play")
def play_notifications():
    wait(1.5)
    notify("Messages", "Morgan Example", "Are we still on for the lake on Saturday?", "mail-unread")
    wait(4.5)
    notify("Mail", "Book club", "Chapter four for Thursday, and who brings the cake?", "mail-message-new")
    wait(4.5)

def setup_media(): fresh(catEnabled="false", ambientGlow="false"); start_player(); wait(3)
def play_media():
    wait(3.0); player("Next"); wait(3.5); player("Pause"); wait(1.8); player("Play"); wait(2.0)

def setup_glow(): fresh(catEnabled="false", ambientGlow="false"); start_player(); wait(3)
def play_glow():
    wait(1.5); setting("ambientGlow", "true"); wait(6.5); setting("ambientGlow", "false"); wait(1.5)

def setup_media_cat(): fresh(ambientGlow="false", catSleepSeconds="600"); stop("tools/demo/player", "pw-play"); wait(2)
def play_media_cat():
    wait(1.2); start_player(); wait(8.0)

def setup_colours(): fresh(catEnabled="false"); stop("tools/demo/player", "pw-play")
def play_colours():
    # the notch's three colours (Settings → Notch → Colour), then ready-made looks (Settings → Appearance)
    wait(1.5)
    for colour in ("0", "1"):
        setting("notchColor", colour); wait(1.8)
    for preset in ("aurora", "ocean", "sunset", "symbiot"):
        setting("customStyle", json.dumps({"preset": preset})); wait(1.6)

def setup_cat_sleep(): fresh(catSleepSeconds="5"); stop("tools/demo/player", "pw-play"); wait(1)
def play_cat_sleep():
    wait(6.5)                                   # it curls up
    notify("Calendar", "Dentist at 16:30", "Harbour Street 12", "view-calendar")
    wait(5.0)

def setup_recording(): fresh(catEnabled="false"); stop("tools/demo/player", "pw-play"); screen_stream()
def play_recording():
    wait(1.5); recording(True); wait(8.0); recording(False); wait(2.0)

def setup_language(): fresh(catEnabled="false", language="en"); stop("tools/demo/player", "pw-play"); screen_stream(); recording(True); wait(2)
def play_language():
    wait(2.5); setting("language", "tr"); wait(3.5); setting("language", "en"); wait(2.5)
def done_language(): recording(False); stop("gst-launch")

def setup_call(): fresh(catSleepSeconds="5"); stop("tools/demo/player", "pw-play"); wait(6)
def play_call():
    wait(2.0); call("ringing"); wait(7.5)

def setup_suggestion():
    fresh(catEnabled="false", suggestionsEnabled="true"); stop("tools/demo/player", "pw-play"); screen_stream()
def play_suggestion():
    wait(1.5); recording(True); wait(9.0)
def done_suggestion(): recording(False); stop("gst-launch")

def setup_push(): fresh(catEnabled="false"); stop("tools/demo/player", "pw-play")
def play_push():
    wait(1.0)
    push("--id", "backup", "--title", "Backup", "--subtitle", "Documents", "--icon", "document-save", "--color", "blue", "--progress", "5")
    for p in (25, 45, 65, 85, 100):
        wait(1.0); push("--id", "backup", "--progress", str(p))
    wait(0.6); push("--id", "backup", "--done", "--status", "success"); wait(3.0)

def setup_download(): fresh(catEnabled="false"); stop("tools/demo/player", "pw-play")
def play_download():
    downloads = root() / "home" / "Downloads"; downloads.mkdir(parents=True, exist_ok=True)
    target = downloads / "atlas-of-lakes.iso"
    if target.exists(): target.unlink()
    wait(0.8)
    # (in a terminal of its own, as somebody would start it: a command without one is a background job,
    # which the island leaves alone unless told otherwise)
    inside("script", "-qfc", f"curl -s -o {shlex.quote(str(target))} 'http://127.0.0.1:{PORT}/download/atlas-of-lakes.iso?mb=220'", "/dev/null")
    wait(3.5)

def setup_calendar():
    # The meeting starts 80 s from now: time for a fresh island to fetch the calendar, and the clip
    # begins six seconds before the start.
    starts = time.time() + 80
    subprocess.run([str(HERE / "make-data"), str(root() / "demo"), "--port", str(PORT), "--meeting-in", f"{80 / 60:.4f}"], check=True, stdout=subprocess.DEVNULL)
    sources = dict(l.split("\t", 1) for l in (root() / "demo" / "settings.tsv").read_text().splitlines())["calendarSources"]
    stop("tools/demo/player", "pw-play")
    fresh(catEnabled="false", calendarSources=sources, calendarRefreshMinutes="1", calendarSound="false")
    time.sleep(max(0.0, starts - 6.5 - time.time()))
def play_calendar():
    wait(12.0)

def nothing(): pass

# name → (what the clip shows, set-up, play, after)
SCENES = {
    "notch-states": ("the notch with the clock, a notification, then an activity with its progress", setup_plain, play_states, nothing),
    "notifications-arrival": ("two notifications arrive on the notch", setup_notifications, play_notifications, nothing),
    "media-controls": ("a track on the notch; the next one; paused and playing again", setup_media, play_media, nothing),
    "media-glow": ("the glow in the cover's colour, following the music, switched on and off", setup_glow, play_glow, nothing),
    "media-cat": ("the cat puts on headphones and nods when music starts", setup_media_cat, play_media_cat, nothing),
    "notch-colours": ("the notch black, then in its own colours; then three ready-made looks and back", setup_colours, play_colours, nothing),
    "cat-sleep": ("the cat falls asleep; a notification wakes it", setup_cat_sleep, play_cat_sleep, nothing),
    "recording-indicator": ("a screen recording starts: a blinking red dot and its time; it ends", setup_recording, play_recording, nothing),
    "language-switch": ("the language switched from English to Turkish and back while a recording shows", setup_language, play_language, done_language),
    "call-incoming": ("the sleeping cat; a call comes in, the cat wakes", setup_call, play_call, nothing),
    "suggestions-card": ("suggestions on: a screen recording starts and the island asks whether to hide notifications", setup_suggestion, play_suggestion, done_suggestion),
    "island-push": ("an activity pushed by a program over D-Bus, counting up and finishing", setup_push, play_push, nothing),
    "downloads-tracking": ("a download from the local test server with its size, speed and time left", setup_download, play_download, nothing),
    "calendar-pinned": ("an event pinned before it starts, then started", setup_calendar, play_calendar, nothing),
}

def main():
    ap = argparse.ArgumentParser(add_help=False)
    ap.add_argument("--list", action="store_true"); ap.add_argument("--headless", action="store_true"); ap.add_argument("--prepare", action="store_true")
    ap.add_argument("--out", default=str(REPO / "docs" / "media")); ap.add_argument("--play", default=""); ap.add_argument("--fps", default="15")
    ap.add_argument("--width", default="800"); ap.add_argument("--colors", default="256"); ap.add_argument("-h", "--help", action="store_true"); ap.add_argument("names", nargs="*")
    a = ap.parse_args()
    if a.play:                                   # (inside the session, while tools/demo/record takes its pictures)
        SCENES[a.play][2](); return
    if a.help or not (a.list or a.headless or a.prepare or a.names):
        print("".join(l[2:] if l.startswith("# ") else "\n" for l in Path(__file__).read_text().splitlines(True)[1:21])); return
    if a.list:
        for name, (what, _, _, _) in SCENES.items(): print(f"{name:22} {what}")
        return
    prepare()
    if a.prepare:
        fresh(); return
    names = list(SCENES) if a.headless else a.names
    unknown = [n for n in names if n not in SCENES]
    if unknown: sys.exit(f"no such scene: {', '.join(unknown)} (tools/demo/scenes --list)")
    out = Path(a.out); out.mkdir(parents=True, exist_ok=True)
    for name in names:
        what, setup, play, after = SCENES[name]
        setup()
        command = f"{shlex.quote(sys.executable)} {shlex.quote(str(Path(__file__).resolve()))} --play {shlex.quote(name)}"
        r = subprocess.run([SESSION, "run", str(HERE / "record"), "--out", str(out / f"{name}.gif"), "--crop", NOTCH, "--width", a.width,
                            "--fps", a.fps, "--colors", a.colors, "--while", command], text=True, capture_output=True)
        after()
        print((r.stdout or r.stderr).strip().splitlines()[-1] if (r.stdout or r.stderr).strip() else f"{name}: nothing recorded", flush=True)

if __name__ == "__main__":
    main()

#!/usr/bin/env python3
# record — a clip of the nested session's screen, as a GIF. Run it inside the session:
#
#   tools/nested-session run tools/demo/record --out docs/media/NAME.gif [--crop X,Y,W,H] [--width 800]
#                            [--fps 12] [--seconds 8 | --while "COMMAND"] [--pointer] [--lead 0.5] [--tail 0.8]
#
# How: the session's own Spectacle is started as a service (`spectacle -s`)
# and asked for a picture of the screen `--fps` times a second through its
# D-Bus interface (FullScreen); the pictures (PNG, in the session's
# ~/Pictures/Screenshots) are then cut to --crop, scaled to --width and joined
# by ffmpeg with a palette of their own. Each picture keeps the moment it was
# written, so the clip runs at the speed things happened even where a picture
# came late. Besides NAME.gif it writes NAME.png, the clip's first picture.
#
# Why not a video: Spectacle's and the portal's screen recordings did not
# start in a headless KWin here, and KWin gives its screenshot and recording
# interfaces only to the programs it knows (Spectacle is one). About 12
# pictures a second is what this way gives; faster movement looks choppier in
# the clip than it is on the screen.
#
# --while runs COMMAND (a scene of tools/demo/scenes, say) and records until
# it ends; --pointer puts the pointer into the pictures. Needs ffmpeg,
# python3-dbus and Spectacle.
import argparse, glob, os, subprocess, sys, tempfile, time
from pathlib import Path

import dbus

def spectacle(bus):
    # Spectacle says "A screenshot was saved" after each picture, and the island would show that:
    # in this session it says nothing.
    quiet = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "spectacle.notifyrc"
    if not quiet.exists():
        quiet.write_text("[Event/newScreenshotSaved]\nAction=\n\n[Event/recordingSaved]\nAction=\n")
    if not bus.name_has_owner("org.kde.Spectacle"):
        subprocess.Popen(["spectacle", "-s"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        for _ in range(50):
            if bus.name_has_owner("org.kde.Spectacle"): break
            time.sleep(0.1)
        time.sleep(0.5)
    # (sent as it is: a proxy object would first ask what the service offers and, with no main loop
    # running here, never get to send the call)
    return lambda pointer: bus.call_async("org.kde.Spectacle", "/", "org.kde.Spectacle", "FullScreen", "i", (pointer,),
                                          None, None, require_main_loop=False)

def main():
    ap = argparse.ArgumentParser(description="A clip of the nested session's screen, as a GIF.")
    ap.add_argument("--out", required=True); ap.add_argument("--crop", default=""); ap.add_argument("--width", type=int, default=800)
    ap.add_argument("--fps", type=float, default=12); ap.add_argument("--seconds", type=float, default=8); ap.add_argument("--while", dest="command", default="")
    ap.add_argument("--pointer", action="store_true"); ap.add_argument("--lead", type=float, default=0.5); ap.add_argument("--tail", type=float, default=0.8)
    ap.add_argument("--colors", type=int, default=128); ap.add_argument("--keep", default="", help="keep the pictures in this folder")
    a = ap.parse_args()
    if "ISLAND_SESSION" not in os.environ:
        sys.exit("run this inside the session: tools/nested-session run tools/demo/record …")
    shots = Path.home() / "Pictures" / "Screenshots"          # (the session's home, not yours)
    shots.mkdir(parents=True, exist_ok=True)
    for old in shots.glob("Screenshot_*.png"): old.unlink()
    bus = dbus.SessionBus()
    service = spectacle(bus)
    gap = 1.0 / a.fps

    def shoot(until):
        while time.monotonic() < until():
            began = time.monotonic()
            service(1 if a.pointer else 0)
            bus.flush()
            time.sleep(max(0.0, gap - (time.monotonic() - began)))

    start = time.monotonic()
    if a.command:
        shoot(lambda: start + a.lead)
        scene = subprocess.Popen(a.command, shell=True)
        shoot(lambda: time.monotonic() + 1 if scene.poll() is None else 0)
        end = time.monotonic() + a.tail
        shoot(lambda: end)
    else:
        shoot(lambda: start + a.seconds)
    time.sleep(1.2)                                           # the last pictures are still being written
    frames = sorted(shots.glob("Screenshot_*.png"), key=lambda p: p.stat().st_mtime_ns)
    if len(frames) < 2: sys.exit("no pictures were taken (is Spectacle installed, and the session running?)")

    out = Path(a.out); out.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory() as tmp:
        listing = Path(tmp) / "frames.txt"
        with open(listing, "w") as f:
            for i, frame in enumerate(frames):
                # a picture is shown until the next one was written
                held = (frames[i + 1].stat().st_mtime_ns - frame.stat().st_mtime_ns) / 1e9 if i + 1 < len(frames) else gap
                f.write(f"file '{frame}'\nduration {min(max(held, 0.02), 1.0):.3f}\n")
            f.write(f"file '{frames[-1]}'\n")
        chain = []
        if a.crop:
            x, y, w, h = (int(v) for v in a.crop.split(","))
            chain.append(f"crop={w}:{h}:{x}:{y}")
        chain.append(f"fps={a.fps:g}")
        chain.append(f"scale={a.width}:-1:flags=lanczos")
        filters = ",".join(chain)
        cmd = ["ffmpeg", "-v", "error", "-y", "-f", "concat", "-safe", "0", "-i", str(listing), "-filter_complex",
               f"{filters},split[a][b];[a]palettegen=max_colors={a.colors}:stats_mode=diff[p];[b][p]paletteuse=dither=bayer:bayer_scale=4:diff_mode=rectangle",
               "-loop", "0", str(out)]
        subprocess.run(cmd, check=True)
        subprocess.run(["ffmpeg", "-v", "error", "-y", "-i", str(frames[0]), "-vf", ",".join(c for c in chain if not c.startswith("fps")),
                        "-frames:v", "1", str(out.with_suffix(".png"))], check=True)
    seconds = (frames[-1].stat().st_mtime_ns - frames[0].stat().st_mtime_ns) / 1e9
    if a.keep:
        keep = Path(a.keep); keep.mkdir(parents=True, exist_ok=True)
        for i, frame in enumerate(frames): frame.rename(keep / f"{i:04d}.png")
    else:
        for frame in frames: frame.unlink()
    print(f"{out}: {len(frames)} pictures over {seconds:.1f} s, {out.stat().st_size / 1024:.0f} kB")

if __name__ == "__main__":
    main()

#!/usr/bin/env python3
# make-media — the demo's music and its covers, made here from nothing.
#
#   tools/demo/make-media DIR      three short tunes (DIR/track-N.wav) and their covers (DIR/cover-N.png)
#
# Nobody else's work is in them: the tunes are sums of sine waves with a drum
# on the beat (so the glow has something to follow), the covers are gradients
# with a few shapes. The names of the tracks, the artist and the album are
# made up. Whatever this writes is yours to use as you like (CC0).
# Needs python3 and, for the covers, Pillow.
import math, struct, sys, wave
from pathlib import Path

RATE = 22050
TRACKS = [
    # title, artist, album, beats per minute, seconds, root note (Hz), chord steps, cover colours
    ("Paper Lanterns", "The Tide Pools", "Low Light", 96, 48, 220.00, [0, 5, 7, 3], ("#ff7a59", "#7a3cff", "#ffd166")),
    ("Glass Harbour", "The Tide Pools", "Low Light", 120, 40, 196.00, [0, 3, 8, 5], ("#00c2a8", "#0b4f9e", "#b8f2e6")),
    ("Slow Orbit", "Mira Kessel", "Night Bus", 84, 52, 174.61, [0, 7, 5, 10], ("#f72585", "#3a0ca3", "#4cc9f0")),
]

def tune(bpm, seconds, root, steps):
    beat = 60.0 / bpm
    out = []
    for n in range(int(seconds * RATE)):
        t = n / RATE
        b = t / beat                         # beats since the start
        in_beat = (b % 1.0) * beat           # seconds since the last beat
        bar = int(b // 4)
        f = root * 2 ** (steps[bar % len(steps)] / 12.0)
        # a drum on every beat: a sine that falls from 110 Hz to 45 Hz and fades
        kick = math.sin(2 * math.pi * (45 * in_beat + 65 * (1 - math.exp(-in_beat * 30)) / 30)) * math.exp(-in_beat * 9)
        # a pad: the chord's root, fifth and third, slowly swelling
        swell = 0.6 + 0.4 * math.sin(2 * math.pi * t / (beat * 8))
        pad = (math.sin(2 * math.pi * f * t) + 0.6 * math.sin(2 * math.pi * f * 1.5 * t) + 0.5 * math.sin(2 * math.pi * f * 1.26 * t)) / 2.1
        # a line above it, a note every half beat
        step = [0, 7, 12, 7, 3, 7, 10, 7][int(b * 2) % 8]
        in_note = ((b * 2) % 1.0) * beat / 2
        lead = math.sin(2 * math.pi * f * 2 * 2 ** (step / 12.0) * t) * math.exp(-in_note * 6)
        fade = min(1.0, t / 0.5, (seconds - t) / 1.5)
        out.append(max(-1.0, min(1.0, (0.55 * kick + 0.22 * pad * swell + 0.16 * lead) * fade)))
    return out

def cover(path, colours, seed):
    from PIL import Image, ImageDraw
    size = 512
    a, b, c = [tuple(int(h[i:i + 2], 16) for i in (1, 3, 5)) for h in colours]
    image = Image.new("RGB", (size, size))
    px = image.load()
    for y in range(size):
        for x in range(size):
            k = (x * 0.6 + y * 1.0) / (size * 1.6)
            px[x, y] = tuple(int(a[i] + (b[i] - a[i]) * k) for i in range(3))
    draw = ImageDraw.Draw(image, "RGBA")
    for i in range(5):
        r = 60 + ((seed * 37 + i * 53) % 150)
        cx = (seed * 97 + i * 131) % size
        cy = (seed * 61 + i * 89) % size
        draw.ellipse((cx - r, cy - r, cx + r, cy + r), fill=c + (70,))
    draw.rectangle((40, size - 110, size - 40, size - 100), fill=(255, 255, 255, 200))
    image.save(path)

def main():
    if len(sys.argv) != 2:
        sys.exit(__doc__ or "usage: make-media DIR")
    target = Path(sys.argv[1]); target.mkdir(parents=True, exist_ok=True)
    lines = []
    for i, (title, artist, album, bpm, seconds, root, steps, colours) in enumerate(TRACKS, 1):
        samples = tune(bpm, seconds, root, steps)
        with wave.open(str(target / f"track-{i}.wav"), "wb") as w:
            w.setnchannels(1); w.setsampwidth(2); w.setframerate(RATE)
            w.writeframes(b"".join(struct.pack("<h", int(s * 30000)) for s in samples))
        try:
            cover(target / f"cover-{i}.png", colours, i)
        except ImportError:
            print("Pillow is not installed: no covers", file=sys.stderr)
        lines.append(f"{i}\t{title}\t{artist}\t{album}\t{seconds}")
    (target / "tracks.tsv").write_text("\n".join(lines) + "\n")
    print(f"{len(TRACKS)} tracks in {target}")

if __name__ == "__main__":
    main()

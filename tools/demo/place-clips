#!/usr/bin/env python3
# place-clips — put the clips that exist into the READMEs.
#
#   tools/demo/place-clips [--check]
#
# In README.md and README.tr.md a clip's place is a line
#   <!-- GIF: NAME.gif | alternative text | caption -->
# For every such line whose file is in docs/media the picture is written right
# after it (or brought up to date), between the markers below; a line whose
# clip is not recorded yet stays as it is. --check only says what is missing.
import re, sys
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent.parent
MARK = re.compile(r"^<!-- GIF: (\S+) \| (.*?) \| (.*?) -->$")

def main():
    check = "--check" in sys.argv
    missing = set()
    for name in ("README.md", "README.tr.md"):
        path = REPO / name
        lines = path.read_text().split("\n"); out = []; i = 0
        while i < len(lines):
            line = lines[i]; out.append(line); m = MARK.match(line)
            if m:
                file, alt, caption = m.groups()
                # what was placed before goes; it is written anew
                if i + 1 < len(lines) and lines[i + 1].startswith("<p align=\"center\"><img "):
                    i += 1
                if (REPO / "docs" / "media" / file).exists():
                    alt = alt.replace('"', "&quot;")
                    out.append(f'<p align="center"><img src="docs/media/{file}" alt="{alt}" width="800"><br><sub>{caption}</sub></p>')
                else:
                    missing.add(file)
            i += 1
        if not check: path.write_text("\n".join(out))
    for file in sorted(missing): print("not recorded yet:", file)
    print(f"{len(missing)} clips missing")

if __name__ == "__main__":
    main()

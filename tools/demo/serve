#!/usr/bin/env python3
# serve — one local server for everything the demo fetches. 127.0.0.1 only.
#
#   tools/demo/serve DIR [--port 8377] [--rate MB_PER_S]
#
#   /calendar/work.ics, /calendar/personal.ics   the calendars of tools/demo/make-data (DIR/calendar)
#   /v1/models, /v1/chat/completions             an OpenAI-compatible "model" with canned answers,
#                                                streamed word by word after a short pause. It is a
#                                                stand-in for the clips, not a model: it looks for a
#                                                few words in the question and answers from a list.
#   /download/NAME?mb=N                          N megabytes (1024) of zeros, at --rate MB/s (8):
#                                                something slow to download
#   /catalog/…                                   this repository's catalog/ (the theme store)
# Nothing is written; every request is printed.
import argparse, json, time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from urllib.parse import parse_qs, urlparse

REPO = Path(__file__).resolve().parent.parent.parent
ANSWERS = [
    (("regex", "regular expression"), "A pattern for an ISO date:\n\n```regex\n^\\d{4}-\\d{2}-\\d{2}$\n```\n\n- `\\d{4}` is the year\n- `\\d{2}` the month, then the day\n\nIt checks the **shape**, not whether the date exists."),
    (("python", "list", "sort"), "Sort by a key with `sorted`:\n\n```python\npeople = sorted(people, key=lambda p: p.age)\n```\n\n`sorted` returns a new list; `list.sort()` sorts in place."),
    (("git", "undo", "commit"), "To undo the last commit and keep its changes:\n\n```bash\ngit reset --soft HEAD~1\n```\n\nUse `--hard` only if the changes can go."),
    (("tea", "coffee"), "For black tea: water just off the boil, **3 to 4 minutes**. Longer makes it bitter, not stronger; for stronger tea use more leaves."),
]
DEFAULT = "This is the demo provider: a small local server with a few canned answers. It only knows about **regular expressions**, sorting a list in **Python**, undoing a **git** commit and brewing **tea**."

class Handler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"
    def log_message(self, fmt, *args):
        print(f"{self.command} {self.path}", flush=True)
    def send(self, code, body, kind="application/json"):
        data = body if isinstance(body, bytes) else body.encode()
        self.send_response(code); self.send_header("Content-Type", kind); self.send_header("Content-Length", str(len(data)))
        self.send_header("Connection", "close"); self.end_headers(); self.wfile.write(data)
    def file(self, path, kind):
        if path.is_file(): self.send(200, path.read_bytes(), kind)
        else: self.send(404, "{}")
    def do_GET(self):
        url = urlparse(self.path); path = url.path
        if path.startswith("/calendar/") and ".." not in path:
            self.file(self.server.data / path.lstrip("/"), "text/calendar; charset=utf-8")
        elif path.startswith("/catalog/") and ".." not in path:
            self.file(REPO / path.lstrip("/"), "application/json")
        elif path == "/v1/models":
            self.send(200, json.dumps({"object": "list", "data": [{"id": "demo-canned-answers", "object": "model"}]}))
        elif path.startswith("/download/"):
            total = int(parse_qs(url.query).get("mb", ["1024"])[0]) * 1024 * 1024
            self.send_response(200); self.send_header("Content-Type", "application/octet-stream")
            self.send_header("Content-Length", str(total)); self.send_header("Connection", "close"); self.end_headers()
            chunk = bytes(64 * 1024); sent = 0; per_second = self.server.rate * 1024 * 1024; start = time.monotonic()
            try:
                while sent < total:
                    self.wfile.write(chunk[:min(len(chunk), total - sent)]); sent += len(chunk)
                    ahead = sent / per_second - (time.monotonic() - start)
                    if ahead > 0: time.sleep(ahead)
            except (BrokenPipeError, ConnectionResetError):
                pass
        else:
            self.send(404, "{}")
    def do_POST(self):
        length = int(self.headers.get("Content-Length", 0)); body = self.rfile.read(length) if length else b"{}"
        if urlparse(self.path).path != "/v1/chat/completions":
            self.send(404, "{}"); return
        try: asked = json.loads(body)
        except ValueError: asked = {}
        question = ""
        for message in asked.get("messages", []):
            if message.get("role") == "user":
                content = message.get("content", ""); question = content if isinstance(content, str) else json.dumps(content)
        low = question.lower()
        answer = next((text for words, text in ANSWERS if any(w in low for w in words)), DEFAULT)
        self.send_response(200); self.send_header("Content-Type", "text/event-stream"); self.send_header("Cache-Control", "no-cache")
        self.send_header("Connection", "close"); self.end_headers()
        try:
            time.sleep(1.6)                     # "thinking"
            pieces = answer.replace("\n", " \n").split(" ")
            for i, piece in enumerate(pieces):
                delta = {"choices": [{"index": 0, "delta": {"content": piece + (" " if i < len(pieces) - 1 and not piece.endswith("\n") else "")}}]}
                self.wfile.write(f"data: {json.dumps(delta)}\n\n".encode()); self.wfile.flush(); time.sleep(0.045)
            self.wfile.write(b'data: {"choices":[{"index":0,"delta":{},"finish_reason":"stop"}]}\n\ndata: [DONE]\n\n'); self.wfile.flush()
        except (BrokenPipeError, ConnectionResetError):
            pass

def main():
    ap = argparse.ArgumentParser(description="One local server for everything the demo fetches.")
    ap.add_argument("dir"); ap.add_argument("--port", type=int, default=8377); ap.add_argument("--rate", type=float, default=8, metavar="MB_PER_S")
    a = ap.parse_args()
    server = ThreadingHTTPServer(("127.0.0.1", a.port), Handler)
    server.data = Path(a.dir); server.rate = a.rate; server.daemon_threads = True
    print(f"serving {server.data} on http://127.0.0.1:{server.server_address[1]}", flush=True)
    try: server.serve_forever()
    except KeyboardInterrupt: pass

if __name__ == "__main__":
    main()

#!/usr/bin/env python3
# summarize — the CSV files of tools/bench/run as tables and pictures.
#
#   tools/bench/summarize [--raw docs/perf/raw] [--out docs/perf] [--readme]
#
# Writes into --out:
#   summary.csv   one row per scenario, every figure
#   summary.md    the same as a Markdown table (what docs/PERFORMANCE.md shows)
#   cpu.svg       CPU per scenario: the shell, the compositor and the sensor daemon
#   soak.svg      memory over a long run (when raw/soak.*.csv is there), with its slope
# and with --readme the figures of docs/PERFORMANCE.md and the short table of
# README.md and README.tr.md, each between its marks, with a list of what is
# not measured yet.
#
# Only what was measured whole counts: where a folder has marks (done.tsv,
# tools/bench/done) a file without its mark is left out and named. Such a
# file was cut off, or is not the file that was marked.
#
# How a figure is made: a repetition's CPU is its whole CPU time over its whole
# duration (per cent of one core); a scenario's is the median of its
# repetitions, with the lowest and highest beside it. "1 s p95 / max" are over
# every single second of every repetition (CPU time comes in steps of 10 ms,
# so one second reads 0, 1, 2 … per cent). "over baseline" is the scenario's
# median minus the baseline's: what the island adds to the same shell.
import argparse, csv, importlib.machinery, importlib.util, re, statistics as st, subprocess, sys
from collections import defaultdict
from pathlib import Path

HERE = Path(__file__).resolve().parent
REPO = HERE.parent.parent
DONE = str(HERE / "done")

def whole_rows(path):
    """The whole rows of a CSV: a run that was cut off (the computer went off) may end in half a line or in zero bytes."""
    with open(path, newline="", errors="replace") as f:
        lines = [line for line in f if "\0" not in line]
    return [row for row in csv.DictReader(lines) if None not in row and None not in row.values()]

def marked(path):
    """Whether a file has its mark (tools/bench/done), and what is wrong when it has not."""
    r = subprocess.run([DONE, "check", str(path)], capture_output=True, text=True)
    return r.returncode == 0, r.stdout.strip()

def load(raw):
    """scenario → [repetition → process → rows], and the files that were left out with the reason"""
    runs, left = defaultdict(dict), []
    marks = (Path(raw) / "done.tsv").exists()       # a folder measured before there were marks counts as it is
    for path in sorted(Path(raw).glob("*.csv")):
        m = re.fullmatch(r"(.+?)\.(\d+)\.csv", path.name)
        if not m or "+frames" in path.name or path.name.endswith(".frames.csv"):
            continue
        ok, why = marked(path) if marks else (True, "")
        if not ok:
            left.append((path.name, why)); continue
        by = defaultdict(list)
        for row in whole_rows(path):
            by[row["process"]].append(row)
        if by: runs[m.group(1)][int(m.group(2))] = by
    return runs, left

def marks(raw):
    """file name → its mark, as tools/bench/done wrote it"""
    try: lines = (Path(raw) / "done.tsv").read_text(errors="replace").splitlines()
    except OSError: return {}
    head = lines[0].split("\t") if lines else []
    return {p[0]: dict(zip(head, p)) for p in (line.split("\t") for line in lines[1:]) if len(p) == len(head)}

def num(row, key):
    try: return float(row[key])
    except (ValueError, KeyError, TypeError): return 0.0

def rep_stats(rows):
    seconds = len(rows) or 1
    return {
        "cpu": sum(num(r, "cpu_ms") for r in rows) / seconds / 10.0,
        "child": sum(num(r, "child_ms") for r in rows) / seconds / 10.0,
        "wake": sum(num(r, "wake") for r in rows) / seconds,
        "spawned": sum(num(r, "spawned") for r in rows) * 3600.0 / seconds,
        "rss": st.median(num(r, "rss_kb") for r in rows) / 1024.0,
        "pss": st.median(num(r, "pss_kb") for r in rows) / 1024.0,
        "threads": st.median(num(r, "threads") for r in rows),
        "fds": st.median(num(r, "fds") for r in rows),
        "gpu": sum(num(r, "gpu_pct") for r in rows) / seconds,
    }

def summarize(runs):
    out = {}
    for name, reps in runs.items():
        per = {p: [rep_stats(by[p]) for by in reps.values() if p in by] for p in ("plasmashell", "kwin_wayland", "ksystemstats")}
        shell = per["plasmashell"]
        if not shell: continue
        seconds = sorted(num(r, "cpu_pct") for by in reps.values() for r in by.get("plasmashell", []))
        med = lambda rows, key: st.median(r[key] for r in rows) if rows else 0.0
        out[name] = {
            "reps": len(shell), "cpu": med(shell, "cpu"), "cpu_min": min(r["cpu"] for r in shell), "cpu_max": max(r["cpu"] for r in shell),
            "cpu_p95": seconds[int(len(seconds) * 0.95) - 1] if seconds else 0.0, "cpu_peak": seconds[-1] if seconds else 0.0,
            "child": med(shell, "child"), "wake": med(shell, "wake"), "spawned": med(shell, "spawned"),
            "rss": med(shell, "rss"), "pss": med(shell, "pss"), "threads": med(shell, "threads"), "fds": med(shell, "fds"), "gpu": med(shell, "gpu"),
            "kwin": med(per["kwin_wayland"], "cpu"), "kwin_gpu": med(per["kwin_wayland"], "gpu"), "sensors": med(per["ksystemstats"], "cpu"),
            "sensors_ran": bool(per["ksystemstats"]),       # without the island nothing starts the sensor daemon
        }
    return out

def order(names, listing):
    known = [n for n in listing if n in names]
    return known + sorted(n for n in names if n not in known)

def scenario_list():
    """Names, descriptions and whether a pointer is needed, as tools/bench/run has them."""
    sys.dont_write_bytecode = True
    loader = importlib.machinery.SourceFileLoader("bench_run", str(HERE / "run"))
    run = importlib.util.module_from_spec(importlib.util.spec_from_loader("bench_run", loader))
    loader.exec_module(run)
    return [(s[0], s[1], s[5]) for s in run.SCENARIOS]


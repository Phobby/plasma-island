    .s1{fill:#2a78d6}.s2{fill:#eb6834}.s3{fill:#1baf7a}.l1{stroke:#2a78d6}.l2{stroke:#eb6834}.gap{stroke:#fcfcfb}
    text{font-family:system-ui,-apple-system,"Segoe UI",sans-serif}
    @media (prefers-color-scheme: dark){
      .bg{fill:#1a1a19}.ink{fill:#ffffff}.ink2{fill:#c3c2b7}.grid{stroke:#2c2c2a}.axis{stroke:#383835}
      .s1{fill:#3987e5}.s2{fill:#d95926}.s3{fill:#199e70}.l1{stroke:#3987e5}.l2{stroke:#d95926}.gap{stroke:#1a1a19}
    }
  </style>"""

def nice(top):
    for step in (0.1, 0.2, 0.25, 0.5, 1, 2, 2.5, 5, 10, 20, 25, 50, 100, 200, 500, 1000):
        if top / step <= 6: return step
    return top / 5

def bar_end(x, y, w, h, last):
    """A segment: square at its start, 4px round at the bar's end when it is the last one."""
    if w <= 0: return ""
    if not last or w < 5: return f'M{x:.1f},{y}h{w:.1f}v{h}h{-w:.1f}z'
    return f'M{x:.1f},{y}h{w - 4:.1f}a4,4 0 0 1 4,4v{h - 8}a4,4 0 0 1 -4,4h{-(w - 4):.1f}z'

def cpu_chart(summary, names, labels, path):
    rows = [(n, summary[n]) for n in names]
    left, right, top, band, bar = 260, 70, 64, 30, 16
    width, height = 860, top + band * len(rows) + 44
    most = max((s["cpu"] + s["kwin"] + s["sensors"]) for _, s in rows) or 1
    step = nice(most); most = step * (int(most / step) + 1)
    scale = (width - left - right) / most
    o = [f'<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 {width} {height}" width="{width}" height="{height}" role="img" '
         f'aria-label="CPU per scenario, per cent of one core">', STYLE, f'<rect class="bg" width="{width}" height="{height}"/>',
         f'<text class="ink" x="16" y="24" font-size="15" font-weight="600">CPU while the island does this, per cent of one core</text>']
    x = 16
    for cls, text in (("s1", "plasmashell"), ("s2", "KWin (the compositor)"), ("s3", "ksystemstats (sensors)")):
        o.append(f'<rect class="{cls}" x="{x}" y="36" width="10" height="10" rx="2"/><text class="ink2" x="{x + 15}" y="45" font-size="12">{text}</text>')
        x += 30 + len(text) * 6.6
    v = 0.0
    while v <= most + 1e-9:
        gx = left + v * scale
        o.append(f'<line class="{"axis" if v == 0 else "grid"}" x1="{gx:.1f}" y1="{top - 4}" x2="{gx:.1f}" y2="{top + band * len(rows)}" stroke-width="1"/>')
        o.append(f'<text class="muted" x="{gx:.1f}" y="{top + band * len(rows) + 16}" font-size="11" text-anchor="middle">{v:g}</text>')
        v += step
    o.append(f'<text class="muted" x="{left + (width - left - right) / 2:.1f}" y="{top + band * len(rows) + 34}" font-size="11" text-anchor="middle">% of one core (median of the runs)</text>')
    for i, (name, s) in enumerate(rows):
        y = top + i * band + (band - bar) / 2
        o.append(f'<text class="ink2" x="{left - 10}" y="{y + bar - 4}" font-size="12" text-anchor="end">{labels.get(name, name)}</text>')
        parts = [("s1", s["cpu"]), ("s2", s["kwin"]), ("s3", s["sensors"])]
        shown = [(c, val) for c, val in parts if val * scale >= 0.5]
        at = left
        for k, (cls, val) in enumerate(shown):
            w = val * scale
            gap = 2 if k < len(shown) - 1 else 0
            o.append(f'<path class="{cls}" d="{bar_end(at, y, max(w - gap, 0.5), bar, k == len(shown) - 1)}"><title>{name}: {cls} {val:.2f}%</title></path>')
            at += w
        total = s["cpu"] + s["kwin"] + s["sensors"]
        o.append(f'<text class="ink" x="{at + 6:.1f}" y="{y + bar - 4}" font-size="12">{total:.2f}</text>')
    o.append("</svg>")
    Path(path).write_text("\n".join(o) + "\n")

def slope(xs, ys):
    n = len(xs); mx, my = sum(xs) / n, sum(ys) / n
    den = sum((x - mx) ** 2 for x in xs)
    return sum((x - mx) * (y - my) for x, y in zip(xs, ys)) / den if den else 0.0

def soak_chart(raw, path):
    # The whole run; as long as there is none, the longest of the runs that were cut off (soak.cut-….csv).
    files = [Path(raw) / "soak.1.csv"] if (Path(raw) / "soak.1.csv").exists() else sorted(Path(raw).glob("soak.cut-*.csv"))
    runs = [[r for r in whole_rows(f) if r["process"] == "plasmashell"] for f in files]
    rows = max(runs, key=len, default=[])
    if len(rows) < 10: return None
    t = [num(r, "t") / 3600.0 for r in rows]; rss = [num(r, "rss_kb") / 1024.0 for r in rows]; pss = [num(r, "pss_kb") / 1024.0 for r in rows]
    warm = [i for i, x in enumerate(t) if x >= min(0.25, t[-1] / 4)]          # the first quarter hour is warming up
    facts = {"hours": t[-1], "rss_slope": slope([t[i] for i in warm], [rss[i] for i in warm]), "pss_slope": slope([t[i] for i in warm], [pss[i] for i in warm]),
             "rss_first": rss[warm[0]], "rss_last": rss[-1], "pss_first": pss[warm[0]], "pss_last": pss[-1],
             "threads": (min(num(r, "threads") for r in rows), max(num(r, "threads") for r in rows)),
             "fds": (min(num(r, "fds") for r in rows), max(num(r, "fds") for r in rows))}
    width, height, left, right, top, bottom = 860, 340, 56, 150, 56, 44
    lo, hi = min(pss + rss), max(pss + rss); pad = (hi - lo) * 0.1 + 1; lo, hi = lo - pad, hi + pad
    step = nice(hi - lo); lo = step * int(lo / step); hi = step * (int(hi / step) + 1)
    X = lambda x: left + x / t[-1] * (width - left - right); Y = lambda y: top + (hi - y) / (hi - lo) * (height - top - bottom)
    o = [f'<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 {width} {height}" width="{width}" height="{height}" role="img" aria-label="Memory of plasmashell over a long run">',
         STYLE.replace(".l1{stroke", ".l1{fill:none;stroke").replace(".l2{stroke", ".l2{fill:none;stroke"), f'<rect class="bg" width="{width}" height="{height}"/>',
         f'<text class="ink" x="16" y="24" font-size="15" font-weight="600">Memory of plasmashell with the island over {t[-1]:.1f} hours of mixed activity, MB</text>',
         f'<rect class="s1" x="16" y="34" width="10" height="10" rx="2"/><text class="ink2" x="31" y="43" font-size="12">resident (RSS)</text>',
         f'<rect class="s2" x="130" y="34" width="10" height="10" rx="2"/><text class="ink2" x="145" y="43" font-size="12">proportional (PSS)</text>']
    v = lo
    while v <= hi + 1e-9:
        o.append(f'<line class="grid" x1="{left}" y1="{Y(v):.1f}" x2="{width - right}" y2="{Y(v):.1f}" stroke-width="1"/>')
        o.append(f'<text class="muted" x="{left - 8}" y="{Y(v) + 4:.1f}" font-size="11" text-anchor="end">{v:g}</text>')
        v += step
    hours = 0.0
    while hours <= t[-1] + 1e-9:
        o.append(f'<text class="muted" x="{X(hours):.1f}" y="{height - bottom + 16}" font-size="11" text-anchor="middle">{hours:g} h</text>')
        hours += 0.5 if t[-1] <= 4 else 1
    o.append(f'<line class="axis" x1="{left}" y1="{height - bottom}" x2="{width - right}" y2="{height - bottom}" stroke-width="1"/>')
    keep = max(1, len(t) // 600)
    for cls, ys, label, tilt in (("l1", rss, "RSS", facts["rss_slope"]), ("l2", pss, "PSS", facts["pss_slope"])):
        pts = " ".join(f"{X(t[i]):.1f},{Y(ys[i]):.1f}" for i in range(0, len(t), keep))
        o.append(f'<polyline class="{cls}" points="{pts}" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"/>')
        o.append(f'<text class="ink2" x="{width - right + 8}" y="{Y(ys[-1]) + 4:.1f}" font-size="12">{label} {ys[-1]:.0f} MB ({tilt:+.1f} MB/h)</text>')
    o.append("</svg>")
    Path(path).write_text("\n".join(o) + "\n")
    return facts


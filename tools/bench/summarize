def short_missing(summary, have, turkish):
    """The READMEs' list of what has no figure yet."""
    items = []
    for names, english, turkce in MISSING:
        if not any(n in summary for n in names): items.append(turkce if turkish else english)
        else: items += [f"`{n}`" for n in names if n not in summary]
    items += [(turkce if turkish else english) for key, english, turkce in BESIDE if not have[key]]
    if not items: return ""
    head = ("**Henüz ölçülmedi** (bunlar için rakam verilmiyor):" if turkish else "**Not measured yet** (no figure is given for these):")
    return head + "\n\n" + "\n".join(f"- {item}" for item in items)

def startup_table(raw):
    """The start of the shell, from raw/startup.csv; "" when it was not measured whole."""
    path = Path(raw) / "startup.csv"
    if not path.exists() or ((Path(raw) / "done.tsv").exists() and not marked(path)[0]): return ""
    rows = whole_rows(path)
    def figure(kind, key):
        v = [float(r[key]) for r in rows if r["shell"] == kind and r[key] not in ("", "-1")]
        return (f"{st.median(v):.2f} ({min(v):.2f}–{max(v):.2f})", len(v)) if v else ("–", 0)
    (without, n), (with_, _), (service, _) = figure("baseline", "shell_answers_s"), figure("island", "shell_answers_s"), figure("island", "island_service_s")
    return "\n".join(["### The start of the shell", "",
                      f"`tools/bench/startup`: plasmashell is started {n} times without the island and {n} times with it; the median, with the lowest and the highest.", "",
                      "| | Seconds |", "|---|---|",
                      f"| Until the shell answers on D-Bus, without the island | {without} |", f"| The same, with the island | {with_} |",
                      f"| Until the island's own D-Bus service is there | {service} |"])


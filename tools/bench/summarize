    o = ["## The figures", ""]
    if days:
        o += [f"Taken {'on ' + days[0] if len(days) == 1 else 'from ' + days[0] + ' to ' + days[-1]}, of the island's code with the id "
              f"{' and '.join('`' + c + '`' for c in codes)} (a checksum of `org.phobby.dynamicisland/` and `native/`: `tools/bench/done code` says a "
              "checkout's, [`perf/raw/done.tsv`](perf/raw/done.tsv) the one of every file)."
              + (" **The island's code has changed since, and nothing was measured again:** the figures are of that code, not of this checkout's." if changed else ""), ""]
    o += table + [""]
    fewer = [f"`{n}` has {summary[n]['reps']}" for n in names if summary[n]["reps"] != 3]
    notes = []
    if fewer: notes.append(f"Runs: three for every scenario, but {' and '.join(fewer)}. A run that was cut off (the computer went off), or was not taken whole, "
                           "has no mark in `done.tsv` and is not counted.")
    if any(not summary[n]["sensors_ran"] for n in names): notes.append("\"–\" under sensors: the daemon was not running (without the island nothing starts it).")
    if notes: o += [" ".join(notes), ""]
    o += ['<p align="center"><img src="perf/cpu.svg" alt="A bar for every scenario of the table: the CPU of plasmashell, of KWin and of ksystemstats, in per cent of one core." width="860"></p>', ""]
    start = startup_table(raw)
    if start: o += [start, ""]
    missing = [f"`{n}`: {what}" for n, what, pointer in listing if n not in summary and not pointer]
    if not have["frames"]: missing.append("Frames per second and frame times (`tools/bench/run --frames`).")
    if not have["soak"]: missing.append("The long run of two hours (`tools/bench/soak`): whether memory, threads or file descriptors grow.")
    if not have["energy"]: missing.append("Energy in watts: see \"Energy\" below.")
    missing.append("The scenarios that need a pointer (" + ", ".join(f"`{n}`" for n, _, pointer in listing if pointer) + "): see \"What could not be measured\" below.")
    o += ["## Not measured yet", "", "No figure is given for any of these; `tools/bench/chain` takes all but the last two (\"Taking your own\" below).", ""]
    o += [f"- {item}" for item in missing]
    return "\n".join(o)

def between(path, begin, end, text):
    """Replace what stands between two marker lines of a file."""
    s = Path(path).read_text()
    a, b = s.index(begin) + len(begin), s.index(end)
    Path(path).write_text(s[:a] + "\n" + text.strip("\n") + "\n" + s[b:])

def main():
    ap = argparse.ArgumentParser(description="The CSV files of tools/bench/run as tables and pictures.")
    ap.add_argument("--raw", default=str(REPO / "docs" / "perf" / "raw")); ap.add_argument("--out", default=str(REPO / "docs" / "perf"))
    ap.add_argument("--readme", action="store_true", help="also write the figures into docs/PERFORMANCE.md and the short table into README.md and README.tr.md (between their marks)")
    a = ap.parse_args()
    runs, left = load(a.raw)
    for file, why in left: print(f"left out: {file} ({why})", file=sys.stderr)
    runs.pop("soak", None)
    summary = summarize(runs)
    if not summary: sys.exit(f"no measurements in {a.raw}")
    listing = scenario_list(); labels = {n: n for n, _, _ in listing}; what = {n: w for n, w, _ in listing}
    names = order(summary.keys(), [n for n, _, _ in listing])
    out = Path(a.out); out.mkdir(parents=True, exist_ok=True)
    base = summary.get("baseline")
    keys = ["reps", "cpu", "cpu_min", "cpu_max", "cpu_p95", "cpu_peak", "child", "wake", "spawned", "rss", "pss", "threads", "fds", "gpu", "kwin", "kwin_gpu", "sensors"]
    with open(out / "summary.csv", "w", newline="") as f:
        w = csv.writer(f); w.writerow(["scenario"] + keys)
        for n in names: w.writerow([n] + ["" if k == "sensors" and not summary[n]["sensors_ran"] else round(summary[n][k], 3) for k in keys])
    md = ["| Scenario | runs | plasmashell CPU % (lowest–highest run) | over baseline | 1 s p95 / max | KWin % | sensors % | wakeups/s | child processes/h | RSS MB | PSS MB |",
          "|---|---|---|---|---|---|---|---|---|---|---|"]
    for n in names:
        s = summary[n]
        over = f"{s['cpu'] - base['cpu']:+.2f}" if base and n != "baseline" else "–"
        md.append(f"| `{n}`: {what.get(n, '')} | {s['reps']} | **{s['cpu']:.2f}** ({s['cpu_min']:.2f}–{s['cpu_max']:.2f}) | {over} | {s['cpu_p95']:.0f} / {s['cpu_peak']:.0f} "
                  f"| {s['kwin']:.2f} | {f'{s["sensors"]:.2f}' if s['sensors_ran'] else '–'} | {s['wake']:.0f} | {s['spawned']:.0f} | {s['rss']:.0f} | {s['pss']:.0f} |")
    (out / "summary.md").write_text("\n".join(md) + "\n")
    cpu_chart(summary, names, labels, out / "cpu.svg")
    facts = soak_chart(a.raw, out / "soak.svg")
    print("\n".join(md))
    if a.readme:
        counted = {f"{name}.{rep}.csv" for name, reps in runs.items() for rep in reps}
        stamps = [m for file, m in marks(a.raw).items() if file in counted]
        code = subprocess.run([DONE, "code"], capture_output=True, text=True).stdout.strip()
        changed = any(m["code"] not in ("-", code) for m in stamps)
        have = taken(a.raw, out)
        between(REPO / "docs" / "PERFORMANCE.md", "<!-- RESULTS:BEGIN -->", "<!-- RESULTS:END -->", results(summary, names, listing, md, left, stamps, changed, have, a.raw))
        for name, turkish in (("README.md", False), ("README.tr.md", True)):
            between(REPO / name, "<!-- PERF:BEGIN -->", "<!-- PERF:END -->",
                    "\n\n".join(filter(None, [short_table(summary, turkish), short_note(summary, changed, turkish), short_missing(summary, have, turkish)])))
    if facts:
        print(f"\nsoak: {facts['hours']:.2f} h; RSS {facts['rss_first']:.0f} → {facts['rss_last']:.0f} MB ({facts['rss_slope']:+.2f} MB/h), "
              f"PSS {facts['pss_first']:.0f} → {facts['pss_last']:.0f} MB ({facts['pss_slope']:+.2f} MB/h), threads {facts['threads'][0]:.0f}–{facts['threads'][1]:.0f}, "
              f"file descriptors {facts['fds'][0]:.0f}–{facts['fds'][1]:.0f}")

if __name__ == "__main__":
    main()

def taken(raw, out):
    """Which of BESIDE is measured: a file that is there and, where the folder has marks, has its own."""
    whole = lambda path: path.exists() and (not (path.parent / "done.tsv").exists() or marked(path)[0])
    return {"frames": any(whole(f) for f in (Path(out) / "raw-frames").glob("*.frames.csv")), "soak": whole(Path(raw) / "soak.1.csv"),
            "energy": any(Path(raw).glob("energy*.csv")), "pointer": False}

def short_table(summary, turkish):
    head = ("| Durum | plasmashell | + KWin | + algılayıcı servisi | Uyanma/sn | Bellek (RSS / PSS) |" if turkish
            else "| State | plasmashell | + KWin | + sensor service | Wakeups/s | Memory (RSS / PSS) |")
    rows = [head, "|---|---|---|---|---|---|"]
    for name, english, turkce in SHORT:
        if name not in summary: continue
        s = summary[name]
        pct = lambda v: (f"%{v:.2f}".replace(".", ",") if turkish else f"{v:.2f} %")
        rows.append(f"| {turkce if turkish else english} | {pct(s['cpu'])} | {pct(s['kwin'])} | {pct(s['sensors']) if s['sensors_ran'] else '–'} | {s['wake']:.0f} "
                    f"| {s['rss']:.0f} / {s['pss']:.0f} MB |")
    return "\n".join(rows)


#!/usr/bin/env python3
# startup — how long plasmashell takes to come up, with and without the island.
#
#   tools/bench/startup [--reps 5] [--out docs/perf/raw/startup.csv]
#
# In tools/nested-session: plasmashell is started and the time is taken until
# it answers on D-Bus (the shell is up, its desktop loaded) and, with the
# island, until the island's own D-Bus service is there (its native part is
# loaded and the widget's main file has run). Each is done --reps times, with
# and without the island on the desktop; the difference of the medians is what
# the island adds to the shell's start.
import argparse, csv, os, statistics as st, subprocess, sys, time
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent.parent
SESSION = str(REPO / "tools" / "nested-session")

def session(*args):
    return subprocess.run([SESSION, *args], capture_output=True, text=True)

def answers(*call):
    return subprocess.run([SESSION, "run", *call], capture_output=True).returncode == 0

def start(island):
    """Seconds until the shell answers, and until the island's service is there (None without it)."""
    for line in session("ps").stdout.splitlines():
        if line.split()[1].endswith("plasmashell"): subprocess.run(["kill", line.split()[0]])
    time.sleep(2)
    began = time.monotonic()
    subprocess.Popen([SESSION, "spawn", "plasmashell", "plasmashell", "--no-respawn"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    shell = service = None
    while time.monotonic() - began < 60 and (shell is None or (island and service is None)):
        if shell is None and answers("qdbus6", "org.kde.plasmashell", "/PlasmaShell"): shell = time.monotonic() - began
        if island and service is None and answers("busctl", "--user", "status", "org.phobby.DynamicIsland"): service = time.monotonic() - began
        time.sleep(0.02)
    return shell, service

def main():
    ap = argparse.ArgumentParser(description="How long plasmashell takes to come up, with and without the island.")
    ap.add_argument("--reps", type=int, default=5); ap.add_argument("--out", default=str(REPO / "docs" / "perf" / "raw" / "startup.csv"))
    a = ap.parse_args()
    rows = []
    for island in (False, True):
        session("shell", *([] if island else ["--no-island"]))        # the desktop as it should be, then timed restarts of it
        time.sleep(3)
        for rep in range(1, a.reps + 1):
            shell, service = start(island)
            rows.append(["island" if island else "baseline", rep, round(shell or -1, 3), round(service, 3) if service else ""])
            print(rows[-1], flush=True)
    Path(a.out).parent.mkdir(parents=True, exist_ok=True)
    with open(a.out, "w", newline="") as f:
        w = csv.writer(f); w.writerow(["shell", "rep", "shell_answers_s", "island_service_s"]); w.writerows(rows)
    med = lambda kind, col: st.median(r[col] for r in rows if r[0] == kind and r[col] != "")
    print(f"shell answers: {med('baseline', 2):.2f} s without the island, {med('island', 2):.2f} s with it; the island's service after {med('island', 3):.2f} s")

if __name__ == "__main__":
    main()
